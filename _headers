# Медиа неизменяемо (имена файлов — из каталога), кэшируем на год:
# после первого прохода вопросы открываются без сети и не жрут трафик.
/media/*
  Cache-Control: public, max-age=31536000, immutable

# База вопросов меняется при обновлении каталога министерства — проверяем свежесть.
/questions.json
  Cache-Control: public, max-age=3600, must-revalidate

/*.png
  Cache-Control: public, max-age=604800
